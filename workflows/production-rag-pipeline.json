  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true,
    "description": "Production RAG Pipeline with hybrid search, reranking, and eval logging. Ingest endpoint: POST /webhook/rag/ingest { text, metadata }. Query endpoint: POST /webhook/rag/query { query, topK, filter }.",
    "tags": ["rag", "production", "pgvector", "rerank", "eval"]
  }
